    local function build_camdata(aimPart, aimPos)
        if not util or not util.EncodeCFrame then return nil end
        local partCF = (typeof(aimPart) == "Instance" and aimPart:IsA("BasePart"))
            and aimPart.CFrame or CFrame.new(aimPos)
        local obj = partCF:ToObjectSpace(CFrame.new(aimPos))
        local cd = {}
        cd[utf8.char(1)] = {
            [utf8.char(0)] = util:EncodeCFrame(partCF),
            [utf8.char(1)] = util:EncodeCFrame(partCF),
            [utf8.char(2)] = aimPart,
            [utf8.char(3)] = util:EncodeCFrame(obj),
        }
        return cd
    end

    local lastHitTarget, lastHitTime = nil, 0
    local _last_shot_time = 0
    local function fireAtTarget(tp, tr, th)
        if not util or not enum or not UseItemRemote then return end
        if not FighterController or not FighterController.LocalFighter then return end
        if not isInMatch() then return end
        -- ★ 매치 시작 후 2초는 무조건 발사 금지
        if tick() - _match_start_t < 2.0 then return end
        if isImmune(tp) then return end

        local now = tick()
        if now - _last_shot_time < 0.02 then return end
        _last_shot_time = now

        local item = FighterController.LocalFighter.EquippedItem; if not item then return end
        local oid
        pcall(function() oid = item:Get("ObjectID") end)
        if not oid then pcall(function() oid = item.ObjectID end) end
        if not oid then return end

        local ammo_before = read_num(item, AMMO_KEYS)

        local aimPart = nil
        local n = Settings.AimPart or "Head"
        if n == "Head" and th then aimPart = th
        elseif n == "Torso" and tp and tp.Character then
            aimPart = tp.Character:FindFirstChild("UpperTorso")
                or tp.Character:FindFirstChild("Torso") or tr
        elseif n == "HumanoidRootPart" and tr then aimPart = tr
        end
        if not aimPart then aimPart = th or tr end
        if not aimPart then return end

        local aimPos = getAimPos(tp, tr, th)
        if not aimPos then return end

        if Settings.Prediction and tr then
            local vel = (tr.AssemblyLinearVelocity or tr.Velocity or Vector3.zero)
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local dist = (aimPos - myRoot.Position).Magnitude
                local t = dist / math.max(Settings.BulletSpeed or 400, 1)
                aimPos = aimPos + vel * t * 0.4
            end
        end

        if Settings.RageBot and th and Settings.AimPart == "Head" then
            aimPos = aimPos + Vector3.new(0, 0.35, 0)
        end

        local cd = build_camdata(aimPart, aimPos)
        if not cd then return end

        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            draw_white_tracer(myRoot.Position + Vector3.new(0, 1.5, 0), aimPos)
        end

        lastHitTarget = tp; lastHitTime = tick()

        local sVal, eVal
        pcall(function() sVal = enum:ToEnum("StartShooting") end)
        pcall(function() eVal = enum:ToEnum("StopShooting")  end)
        if not sVal then sVal = "StartShooting" end
        if not eVal then eVal = "StopShooting"  end

        pcall(function() UseItemRemote:FireServer(oid, sVal, cd, nil) end)
        pcall(function() UseItemRemote:FireServer(oid, "StartShooting", cd, nil) end)
        pcall(function() UseItemRemote:FireServer(oid, eVal, nil, nil) end)
        pcall(function() UseItemRemote:FireServer(oid, "StopShooting", nil, nil) end)

        if Settings.KeepAmmo and type(ammo_before) == "number" then
            for _, k in ipairs(AMMO_KEYS) do
                pcall(function()
                    if type(item:Get(k)) == "number" then item:Set(k, ammo_before) end
                end)
            end
        end
    end

    -- RELOAD
    local ReloadState = { pending_until = 0 }
    local function tryReload(force)
        if not Settings.AutoReload and not force then return end
        if not isInMatch() then return end
        if not FighterController or not FighterController.LocalFighter then return end
        local lf = FighterController.LocalFighter
        local item = lf.EquippedItem
        if not item or not is_gun(item) then return end
        if tick() < ReloadState.pending_until and not force then return end
        ReloadState.pending_until = tick() + 0.05

        local oid
        pcall(function() oid = item:Get("ObjectID") end)
        if not oid then pcall(function() oid = item.ObjectID end) end
        if not oid then return end

        if UseItemRemote then
            local reloadEnum
            pcall(function() reloadEnum = enum:ToEnum("Reload") end)
            if not reloadEnum then reloadEnum = "\027" end

            pcall(function()
                UseItemRemote:FireServer(oid, reloadEnum, {
                    [utf8.char(1)] = utf8.char(1),
                    [utf8.char(2)] = utf8.char(2),
                })
            end)
            pcall(function()
                UseItemRemote:FireServer(oid, reloadEnum, {
                    [utf8.char(1)] = utf8.char(205)..utf8.char(174),
                    [utf8.char(2)] = utf8.char(205)..utf8.char(174),
                })
            end)
            pcall(function() UseItemRemote:FireServer(oid, "Reload", nil, nil) end)
        end

        pcall(function() if item.Reload then item:Reload() end end)
        pcall(function() if item.Refill then item:Refill() end end)
        pcall(function() if lf.Reload   then lf:Reload()   end end)
    end

