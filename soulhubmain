    local function createDropdown(page, text, options, defaultIdx, callback)
        local idx = defaultIdx or 1; local current = options[idx]
        local card = Instance.new("Frame", page)
        card.Size = UDim2.new(1, -10, 0, 30)
        card.BackgroundColor3 = Colors.CardBg; card.ZIndex = 11
        corner(card, 6); stroke(card, Colors.Border, 1)
        local label = Instance.new("TextLabel", card)
        label.Size = UDim2.new(0.42, 0, 1, 0); label.Position = UDim2.fromOffset(8, 0)
        label.BackgroundTransparency = 1; label.Text = "* " .. text
        label.TextColor3 = Colors.White; label.Font = Enum.Font.Arcade
        label.TextSize = 11; label.TextXAlignment = Enum.TextXAlignment.Left; label.ZIndex = 12
        local cycleBtn = Instance.new("TextButton", card)
        cycleBtn.Size = UDim2.new(0.56, -8, 0, 20)
        cycleBtn.Position = UDim2.new(0.44, 0, 0.5, -10)
        cycleBtn.BackgroundColor3 = Colors.Background
        cycleBtn.Text = "< " .. current .. " >"
        cycleBtn.TextColor3 = Colors.Yellow; cycleBtn.Font = Enum.Font.Arcade
        cycleBtn.TextSize = 10; cycleBtn.ZIndex = 12
        corner(cycleBtn, 6); stroke(cycleBtn, Colors.Border, 1)
        cycleBtn.MouseButton1Click:Connect(function()
            idx = idx % #options + 1; current = options[idx]
            cycleBtn.Text = "< " .. current .. " >"
            if callback then pcall(callback, current) end
        end)
    end

