    local AMMO_KEYS = { "Ammo","CurrentAmmo","Bullets","LoadedAmmo","Clip","CurrentClip" }
    local function read_num(item, keys)
        for _, k in ipairs(keys) do
            local ok, v = pcall(function() return item:Get(k) end)
            if ok and type(v) == "number" then return v, k end
        end
        return nil, nil
    end
    local function is_gun(item)
        if not item then return false end
        local n = ""
        pcall(function() n = item.Name or "" end)
        if n == "" then pcall(function() n = item:Get("Name") or "" end) end
        n = string.lower(tostring(n))
        if n:find("katana") or n:find("knife") or n:find("fist") or n:find("axe")
        or n:find("scythe") or n:find("chainsaw") or n:find("grenade")
        or n:find("medkit") or n:find("flash") or n:find("smoke")
        or n:find("molotov") or n:find("grappler") or n:find("shield")
        or n:find("spear") or n:find("maul") or n:find("trowel")
        or n:find("shard") or n:find("dagger") then return false end
