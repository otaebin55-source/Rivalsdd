        corner(colorBox, 6); stroke(colorBox, Colors.Border, 1)
        local presets = {
            Colors.Accent, Colors.Yellow, Colors.Green, Colors.White,
            Color3.fromRGB(0, 150, 255),
        }
        local curIdx = 1
        colorBox.MouseButton1Click:Connect(function()
