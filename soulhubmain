    -- ─────────────────────────────────────────
    local MATCH_ATTRS = {
        "TeamID","TeamId","Team","MatchID","MatchId","Match",
        "DuelID","DuelId","Duel","RoundID","RoundId","Round",
        "InMatch","IsInMatch","InRound","RoundActive","IsPlaying","MatchActive","MatchState",
    }
    local function hasMatchAttribute()
        for _, attr in ipairs(MATCH_ATTRS) do
            local ok, v = pcall(function() return LocalPlayer:GetAttribute(attr) end)
            if ok and v ~= nil and v ~= false then
                return true
            end
        end
        return false
    end

    local function hasLocalFighter()
        if not FighterController then return false end
        local ok, lf = pcall(function() return FighterController.LocalFighter end)
        return ok and lf ~= nil
    end

    local function countLiveOpponents()
        if not FighterController or not FighterController.Objects then return 0 end
        local n = 0
        pcall(function()
            for _, fo in pairs(FighterController.Objects) do
                if fo and fo.Player and fo.Player ~= LocalPlayer then
                    local char = fo.Player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then n = n + 1 end
                end
            end
        end)
        return n
    end

    local function _isInMatch()
        if not hasLocalFighter() then return false end
        if not hasMatchAttribute() then return false end
        if countLiveOpponents() == 0 then return false end
        return true
    end

    -- ★ 매치 시작 그레이스 (스폰킬 방지)
    local _match_start_t = 0
    local _was_in_match = false
    local _last_match_end = 0
    local function isInMatch()
        local r = _isInMatch()
        local now = tick()
        if r and not _was_in_match then
            _match_start_t = now
        end
        if not r and _was_in_match then
            _last_match_end = now
        end
        _was_in_match = r
        return r
    end

    local function isWeaponSelect()
        if not hasLocalFighter() then return false end
        if not hasMatchAttribute() then return false end
        return countLiveOpponents() == 0
    end

    -- ★ 적군만 (팀 비교)
    local function isMatchOpponent(p)
        if p == LocalPlayer then return false end
        if not isInMatch() then return false end
        if not FighterController or not FighterController.Objects then return false end

        local fo = nil
        pcall(function()
            for _, o in pairs(FighterController.Objects) do
                if o and o.Player == p then fo = o; break end
            end
        end)
        if not fo then return false end

        local myTeam
        pcall(function()
            myTeam = LocalPlayer:GetAttribute("TeamID")
                or LocalPlayer:GetAttribute("TeamId")
                or LocalPlayer:GetAttribute("Team")
        end)
        if not myTeam and FighterController.LocalFighter then
            pcall(function()
                myTeam = FighterController.LocalFighter.TeamID
                    or FighterController.LocalFighter:Get("TeamID")
                    or FighterController.LocalFighter:Get("Team")
            end)
        end

        if myTeam ~= nil then
            local theirTeam
            pcall(function()
                theirTeam = p:GetAttribute("TeamID")
                    or p:GetAttribute("TeamId")
                    or p:GetAttribute("Team")
            end)
            if not theirTeam then
                pcall(function()
                    theirTeam = fo.TeamID or fo:Get("TeamID") or fo:Get("Team")
                end)
            end
            if theirTeam ~= nil and theirTeam == myTeam then
                return false
            end
        end

        return true
    end

    -- ★ 스폰 쉴드 3중 감지
    local SHIELD_NAME_FRAGMENTS = {
        "shield","forcefield","force_field","force field",
        "invuln","invinc","godmode","god_mode","spawnprotect","spawn_protect",
        "spawnshield","spawn_shield","blueshield","blue_shield","protection",
    }
    local SHIELD_ATTRS = {
        "ForceField","SpawnShield","SpawnProtection","IsInvulnerable",
        "IsShielded","HasShield","Invulnerable","Godmode","Protected",
        "SpawnGrace","GracePeriod","IsSpawnProtected",
    }

    local function _name_is_shield(n)
        if not n then return false end
        n = string.lower(tostring(n))
        for _, frag in ipairs(SHIELD_NAME_FRAGMENTS) do
            if n:find(frag, 1, true) then return true end
        end
        return false
    end

    local function isImmune(p)
        if not p then return true end
        local char = p.Character; if not char then return true end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return true end

        if char:FindFirstChildOfClass("ForceField") then return true end

        for _, c in ipairs(char:GetDescendants()) do
            if _name_is_shield(c.Name) then return true end
        end

        for _, a in ipairs(SHIELD_ATTRS) do
            local ok, v = pcall(function() return char:GetAttribute(a) end)
            if ok and v and v ~= false then return true end
            ok, v = pcall(function() return p:GetAttribute(a) end)
            if ok and v and v ~= false then return true end
        end

        if FighterController and FighterController.Objects then
            for _, fo in pairs(FighterController.Objects) do
                if fo.Player == p then
                    for _, a in ipairs(SHIELD_ATTRS) do
                        local ok, v = pcall(function() return fo:Get(a) end)
                        if ok and v and v ~= false then return true end
                    end
                    if fo.Humanoid and fo.Humanoid:FindFirstChildOfClass("ForceField") then
                        return true
                    end
                    break
                end
            end
        end

        return false
    end

    local _tgt = { p=nil, r=nil, h=nil, t=0 }
    local function getClosestTarget()
        local now = tick()
        if now - _tgt.t < 0.03 then return _tgt.p, _tgt.r, _tgt.h end
        _tgt.t = now
        local char = LocalPlayer.Character; if not char then return nil,nil,nil end
        local myRoot = char:FindFirstChild("HumanoidRootPart"); if not myRoot then return nil,nil,nil end
        local bp, br, bh, bs = nil, nil, nil, math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and isMatchOpponent(player) and not isImmune(player) then
                local pChar = player.Character
                if pChar then
                    local pR = pChar:FindFirstChild("HumanoidRootPart")
                    local pH = pChar:FindFirstChild("Head")
                    local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
                    if pR and pH and pHum and pHum.Health > 0 then
                        local sc = (myRoot.Position - pR.Position).Magnitude
                        if sc < bs then bs = sc; bp, br, bh = player, pR, pH end
                    end
                end
            end
        end
        _tgt.p, _tgt.r, _tgt.h = bp, br, bh
        return bp, br, bh
    end

    local function getAimPos(tp, tr, th)
        local n = Settings.AimPart or "Head"
        if n == "Head" and th then
            if tr and Settings.HitboxExpand then
                return th.Position:Lerp(tr.Position, 0.25)
            end
            return th.Position
        end
        if n == "Torso" and tp and tp.Character then
            local t = tp.Character:FindFirstChild("UpperTorso")
                or tp.Character:FindFirstChild("Torso")
            if t then return t.Position end
        end
        if n == "HumanoidRootPart" and tr then return tr.Position end
        return th and th.Position or (tr and tr.Position)
    end

    -- LOADOUT
    local _loadout_last = 0
    local function fire_loadout()
        if not PickWeaponsRemote then return end
        if tick() - _loadout_last < 0.2 then return end
        _loadout_last = tick()
        local p = Settings.PrimaryWeapon   or "Assault Rifle"
        local s = Settings.SecondaryWeapon or "Revolver"
        local m = Settings.MeleeWeapon     or "Scythe"
        local u = Settings.UtilityWeapon   or "War Horn"
