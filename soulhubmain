    stack.Padding = UDim.new(0, 3)

    local logCards = {}
    local LOG_MAX = 8
    local function pushLog(attacker, victim, dmg, part)
        if not attacker or not victim or dmg < 1 or dmg > 500 then return end
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 34)
        card.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
        card.BackgroundTransparency = 0.15
        card.BorderSizePixel = 0
        card.LayoutOrder = math.floor(tick() * 1000) % 2147483647
        corner(card, 4)
        local st = Instance.new("UIStroke", card)
        st.Color = Color3.fromRGB(60, 60, 70); st.Thickness = 1
        local nameLbl = Instance.new("TextLabel", card)
        nameLbl.Size = UDim2.new(1, -12, 0, 14)
        nameLbl.Position = UDim2.fromOffset(6, 3)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = attacker
        nameLbl.TextColor3 = Color3.fromRGB(255,255,255)
        nameLbl.Font = Enum.Font.GothamBold; nameLbl.TextSize = 11
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        local detail = Instance.new("TextLabel", card)
        detail.Size = UDim2.new(1, -12, 0, 14)
        detail.Position = UDim2.fromOffset(6, 17)
        detail.BackgroundTransparency = 1
        detail.Text = string.format("hit %s for %d in the %s", victim, math.floor(dmg), part or "HumanoidRootPart")
        detail.TextColor3 = Color3.fromRGB(150,150,160)
        detail.Font = Enum.Font.Gotham; detail.TextSize = 10
        detail.TextXAlignment = Enum.TextXAlignment.Left
        card.Parent = LogContainer
        table.insert(logCards, card)
        while #logCards > LOG_MAX do
            local old = table.remove(logCards, 1)
            if old and old.Parent then old:Destroy() end
        end
        task.delay(3, function()
            if card and card.Parent then
                TweenService:Create(card, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
                TweenService:Create(st, TweenInfo.new(0.4), { Transparency = 1 }):Play()
                TweenService:Create(nameLbl, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
                TweenService:Create(detail, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
                task.delay(0.5, function()
                    if card and card.Parent then card:Destroy() end
                    for i, c in ipairs(logCards) do
                        if c == card then table.remove(logCards, i); break end
                    end
                end)
            end
        end)
    end

    local watched = {}
    local function watchPlayer(p)
        if p == LocalPlayer or watched[p] then return end
        watched[p] = true
        local function onChar(char)
            local hum = char:WaitForChild("Humanoid", 8); if not hum then return end
            local last = hum.Health
            local conn
            conn = hum.HealthChanged:Connect(function(newH)
                if not hum.Parent then pcall(function() conn:Disconnect() end); return end
                local dmg = last - newH; last = newH
                if dmg < 1 or dmg > 500 then return end
                if not isInMatch() then return end
                if not isMatchOpponent(p) then return end
                if lastHitTarget ~= p or tick() - lastHitTime > 1.5 then return end
                local part = "HumanoidRootPart"
                if Settings.AimPart == "Head" then part = "Head"
                elseif Settings.AimPart == "Torso" then part = "UpperTorso" end
                pushLog(LocalPlayer.DisplayName or LocalPlayer.Name,
                    p.DisplayName or p.Name, dmg, part)
            end)
            hum.Destroying:Connect(function() pcall(function() conn:Disconnect() end) end)
        end
        if p.Character then task.spawn(onChar, p.Character) end
        p.CharacterAdded:Connect(function(c) task.spawn(onChar, c) end)
    end
    for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
    Players.PlayerAdded:Connect(watchPlayer)

    task.delay(3, function()
        pcall(function()
            print("[Soul-DIAG] LF:", hasLocalFighter() and "ok" or "nil",
                "Attr:", tostring(hasMatchAttribute()),
                "Opp:", countLiveOpponents(),
                "InMatch:", tostring(isInMatch()),
                "Select:", tostring(isWeaponSelect()),
                "PickW:", PickWeaponsRemote and "ok" or "nil",
                "Queue:", JoinQueueRemote and "ok" or "nil",
                "Vote:", MapVoteRemote and "ok" or "nil")
        end)
    end)
end

