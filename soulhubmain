    verify.Text = "VERIFIED"; verify.Font = Enum.Font.Arcade; verify.TextSize = 10
    verify.TextColor3 = Color3.fromRGB(11, 11, 10); verify.BackgroundColor3 = Color3.fromRGB(92, 196, 96)
    verify.BorderSizePixel = 0; verify.Size = UDim2.new(1, -32, 0, 34)
    verify.Position = UDim2.fromOffset(16, 236)
    local vc = Instance.new("UICorner", verify); vc.CornerRadius = UDim.new(0, 4)

    local status = mk("WAITING FOR KEY INPUT", 7, UDim2.fromOffset(16, 278), muted)

    local dragging, dragStart, panelStart = false, nil, nil
    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and
           input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true; dragStart = input.Position; panelStart = panel.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
    panel.InputBegan:Connect(beginDrag)
    for _, t in ipairs(panel:GetDescendants()) do
        if t:IsA("GuiObject") then t.InputBegan:Connect(beginDrag) end
    end
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or
                         input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            panel.Position = UDim2.new(panelStart.X.Scale, panelStart.X.Offset + d.X,
                                       panelStart.Y.Scale, panelStart.Y.Offset + d.Y)
        end
    end)

    local function setStatus(t, c) status.Text = t; status.TextColor3 = c or muted end
    local busy = false
    local function verifyKey()
        if busy then return end
        local token = keyBox.Text:gsub("%s+", ""):upper()
        if token == "" then setStatus("ENTER A KEY TO CONTINUE", errCol); return end
        if not requestFn then setStatus("REQUEST API UNAVAILABLE", errCol); return end
        busy = true; verify.Active = false
        setStatus("CHECKING TOKEN...", lime)
        task.spawn(function()
            local ok, response = pcall(function()
                return requestFn({
                    Url = API_BASE .. "/keys/verify",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({ token = token }),
                })
            end)
            if not ok or not response or not response.Body then
                busy = false; verify.Active = true
                setStatus("VERIFICATION OFFLINE", errCol); return
            end
            local pOk, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
            busy = false; verify.Active = true
            if not pOk or not data then setStatus("INVALID SERVER RESPONSE", errCol); return end
            if data.ok then
                verify.Text = "ACCESS GRANTED"
                setStatus("TOKEN ACCEPTED / SESSION READY", lime)
                keyBox.Text = ""
                _save_verified(token)
                task.delay(0.6, function()
                    pcall(function() gui:Destroy() end)
                    if on_success then pcall(on_success) end
                end)
            else
                local msgs = { invalid = "KEY NOT RECOGNIZED", expired = "KEY EXPIRED",
                               consumed = "KEY ALREADY USED", missing = "ENTER A KEY TO CONTINUE" }
                setStatus(msgs[data.code] or "VERIFICATION FAILED", errCol)
            end
        end)
    end
    verify.MouseButton1Click:Connect(verifyKey)
    keyBox.FocusLost:Connect(function(enter) if enter then verifyKey() end end)
end

