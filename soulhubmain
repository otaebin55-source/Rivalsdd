    local function makeTracerSegs(player)
        TracerSegs[player] = {}
        for i = 1, 6 do
            local seg = Instance.new("Frame")
            seg.AnchorPoint = Vector2.new(0.5, 0.5); seg.BorderSizePixel = 0
            seg.BackgroundColor3 = Color3.fromRGB(255,40,40)
            seg.Visible = false; seg.ZIndex = 50; seg.Parent = TracerGui
            table.insert(TracerSegs[player], seg)
        end
    end
    local function setSegLine(player, from, to, col)
        local segs = TracerSegs[player]; if not segs then return end
        local dx, dy = to.X - from.X, to.Y - from.Y
        local len = math.sqrt(dx*dx + dy*dy)
        if len < 4 then for _, s in ipairs(segs) do s.Visible = false end; return end
        for i = 1, #segs do
            local t0 = (i - 1) / #segs; local t1 = i / #segs
            local p0 = from + Vector2.new(dx*t0, dy*t0)
            local p1 = from + Vector2.new(dx*t1, dy*t1)
            local s = segs[i]
            s.Size = UDim2.fromOffset((p1-p0).Magnitude + 1, 2)
            s.Position = UDim2.fromOffset((p0.X+p1.X)/2, (p0.Y+p1.Y)/2)
            s.Rotation = math.deg(math.atan2(dy, dx))
            s.BackgroundColor3 = col
            s.BackgroundTransparency = 0.1 + t0 * 0.5
            s.Visible = true
        end
    end

