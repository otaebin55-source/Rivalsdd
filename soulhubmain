local FOLDER, FILE = "SoulHub", "SoulHub/Settings.json"
local function ensureFolder()
    pcall(function() if makefolder and not isfolder(FOLDER) then makefolder(FOLDER) end end)
end
local function serialize()
    local t = {}
    for k, v in pairs(Settings) do
        if typeof(v) == "Color3" then t[k] = { r=v.R, g=v.G, b=v.B, _c=true }
        else t[k] = v end
    end
    return t
end
local function deserialize(d)
    for k, v in pairs(d) do
        if type(v) == "table" and v._c then Settings[k] = Color3.new(v.r, v.g, v.b)
        else Settings[k] = v end
    end
end
local function saveSettings()
    ensureFolder()
    pcall(function() if writefile then writefile(FILE, HttpService:JSONEncode(serialize())) end end)
end
local function loadSettings()
    ensureFolder()
    local ok, raw = pcall(function()
        if isfile and isfile(FILE) and readfile then
            return HttpService:JSONDecode(readfile(FILE))
        end
    end)
    if ok and type(raw) == "table" then deserialize(raw) end
end
pcall(loadSettings)
local function set(k, v) Settings[k] = v; saveSettings() end

